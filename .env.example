# Copy this file to .env and fill in real values.
# cp .env.example .env

NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perla
DATABASE_SSL=false

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# VOICE_API_TOKEN and ADMIN_API_TOKEN must each be at least 24 characters,
# and must NOT be the same value.
VOICE_API_TOKEN=
ADMIN_API_TOKEN=

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters. Only rotate as part of a migration plan
# (rotating loses the ability to decrypt previously stored data).
PII_ENCRYPTION_KEY=

# Comma-separated list of allowed CORS origins (leave empty to disable CORS)
ALLOWED_ORIGINS=

PUBLIC_BASE_URL=http://localhost:3000

# Keep false until read-only tools are verified in production
ENABLE_WRITE_TOOLS=false

LOG_LEVEL=info
